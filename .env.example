# Server-side configuration. Copy to .env; never commit real values.
DATABASE_URL=postgresql+psycopg://cisense:cisense@localhost:5432/cisense
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
# false for local HTTP only; true in HTTPS deployments
COOKIE_SECURE=false
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# GitHub APP client ID and client secret (its OAuth web flow, not a separate OAuth App)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
# Explicit numeric GitHub user IDs, comma-separated; empty grants nobody admin
ADMIN_GITHUB_IDS=
# Only trusted provider-owned hostnames. Never allow user-controlled DNS domains.
LLM_ALLOWED_HOSTS=api.openai.com,api.anthropic.com,generativelanguage.googleapis.com
# Private local development storage; not served by FastAPI
ARTIFACT_DIR=./artifacts
# Set bucket for production; local storage is used when empty.
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_DEFAULT_REGION=us-east-1
# Use workload IAM roles in production. Never put AWS or LLM secrets in frontend env.

# Original B2_o1 prompt path. Blank uses the adjacent Final_data/prompt_b2_o1.txt file.
B2_O1_PROMPT_PATH=
